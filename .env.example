# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o

# Project folders
INPUT_DIR=input_videos
CACHE_DIR=cache
OUTPUT_DIR=outputs
TEMP_DIR=temp
FONT_PATH=assets/fonts/Cairo-Bold.ttf

# Clip selection
DEFAULT_CLIP_COUNT=5
MIN_CLIP_SECONDS=30
MAX_CLIP_SECONDS=60

# Video export
EXPORT_WIDTH=1080
EXPORT_HEIGHT=1920
EXPORT_FPS=30
TRACKING_SAMPLE_FPS=4
SMOOTHING_WINDOW=9

# Captions
CAPTION_MAX_WORDS=4
CAPTION_MIN_WORDS=2
CAPTION_FONT_SIZE=78
CAPTION_ACTIVE_COLOR=#FFD400
CAPTION_INACTIVE_COLOR=#FFFFFF
CAPTION_STROKE_COLOR=#000000
CAPTION_STROKE_WIDTH=5
CAPTION_BOTTOM_MARGIN=260

# Viral hooks
SFX_POP_PATH=assets/sfx/pop.mp3
SFX_VOLUME=0.3
ENABLE_WORD_SFX=true

# Social media profiles and reusable description footers
YOUTUBE_CHANNEL_URL=
YOUTUBE_DEFAULT_DESCRIPTION=
FACEBOOK_PAGE_URL=
FACEBOOK_DEFAULT_DESCRIPTION=
TIKTOK_PROFILE_URL=
TIKTOK_DEFAULT_DESCRIPTION=

# FFmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
